{
  "name": "create-openclass-uniminuto-revealjs",
  "version": "1.3.0",
  "description": "Generador npm de presentaciones docentes OpenClass con Reveal.js: 13 layouts, código con scroll, Mermaid, Chart, actividades y guía del docente",
  "author": "William Herrera",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-openclass-uniminuto-revealjs": "bin/create-openclass-uniminuto-revealjs.mjs"
  },
  "files": [
    "bin",
    "template",
    "docs/GUIA-DEL-CREADOR.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/creator.test.mjs tests/contenido.test.mjs tests/semana.test.mjs",
    "test:p2": "node --test tests/portada-pedagogica.test.mjs",
    "test:docente": "node --test tests/docente-p3.test.mjs",
    "test:seguridad": "node --test tests/publicacion-seguridad.test.mjs",
    "test:build-tech": "node --test tests/build-tech.test.mjs",
    "test:ligeras": "npm test && npm run test:p2 && npm run test:docente && npm run test:seguridad && npm run test:build-tech",
    "test:dom": "node --test --test-concurrency=1 tests/portada-dom.test.mjs",
    "test:portal": "node --test --test-concurrency=1 tests/portal-academico.test.mjs",
    "test:navegador": "node scripts/test-navegador.mjs",
    "test:sitio": "node --test tests/sitio.test.mjs",
    "test:chrome": "npm run test:dom && npm run test:portal && npm run test:navegador",
    "test:release": "npm run test:ligeras && npm run test:chrome && npm run site:build && npm run test:sitio",
    "assets:neutros": "node scripts/render-neutral-assets.mjs && node scripts/render-demo-video.mjs",
    "galeria:capturas": "node scripts/capture-gallery.mjs",
    "site:build": "node scripts/build-site.mjs",
    "pack:check": "npm pack --dry-run --json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "create",
    "openclass",
    "uniminuto",
    "reveal.js",
    "react",
    "educacion",
    "revealjs",
    "presentaciones",
    "markdown",
    "docentes"
  ],
  "homepage": "https://herrerawilliamh.github.io/create-openclass-uniminuto-revealjs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herrerawilliamh/create-openclass-uniminuto-revealjs.git"
  },
  "bugs": {
    "url": "https://github.com/herrerawilliamh/create-openclass-uniminuto-revealjs/issues"
  }
}
