+test('sonda: respuesta B, resultados publicados, sin revelar → ningún campo identifica la correcta', () => {
+  const { a } = nuevo();
+  const s = a.crearSala();
+  const p = a.unir(s.codigo, {});
+  const p2 = a.unir(s.codigo, {});
+  const e = a.crearEncuesta(s.id, encuesta());
+  a.abrirEncuesta(s.id, e.id);
+  a.responder(s.id, p.pid, { encuestaId: e.id, ronda: 1, seleccion: [1] }); // B, la correcta
+  a.responder(s.id, p2.pid, { encuestaId: e.id, ronda: 1, seleccion: [0] });
+  a.cerrarEncuesta(s.id, e.id);
+  a.publicarResultados(s.id, e.id);
+  for (const pid of [p.pid, p2.pid]) {
+    const v = a.estadoParticipante(s.id, pid).encuesta;
+    assert.equal(v.correctaRevelada, false);
+    assert.deepEqual(v.rondas[0].conteos, [1, 1, 0], 'la distribución publicada sí llega');
+    assert.doesNotMatch(JSON.stringify(v), /porcentajeCorrecto|correctas|explicacion/, 'sin acierto, correcta ni explicación');
+  }
+  assert.equal(a.encuestaDocente(s.id, e.id).rondas[0].porcentajeCorrecto, 50, 'el docente conserva su acierto privado');
+  a.revelarCorrecta(s.id, e.id);
+  const rev = a.estadoParticipante(s.id, p.pid).encuesta;
+  assert.deepEqual(rev.correctas, [1]);
+  assert.equal(rev.rondas[0].porcentajeCorrecto, 50, 'tras revelar, el acierto se comparte');
+});
