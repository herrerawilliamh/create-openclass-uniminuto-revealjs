# OpenClass Live — plantilla de configuración. Copiar a .env (NUNCA versionar .env).
# Generar los secretos con:  npm run gen-env   (o el procedimiento del README, sección «Secretos»).

APP_HOST=openclass-live.apps.willedtech.io
APP_URL=https://openclass-live.apps.willedtech.io
TZ=America/Bogota
NODE_ENV=production
PORT=3000

# Secreto de firma de tokens: 48 bytes aleatorios en base64url. Cambiarlo invalida sesiones y claves.
SESSION_SECRET=CAMBIAR_SECRET
# Hash scrypt de la contraseña docente (npm run hash-password). Entre comillas simples por los '$'.
ADMIN_PASSWORD_HASH=CAMBIAR_HASH

# Orígenes de la presentación Reveal.js local (8613 indicado para clase; 8600 es el puerto por defecto de Vite en los cursos).
PRESENTER_ORIGINS=http://localhost:8613,http://localhost:8600
# Detrás de Traefik: la IP de cliente se toma de X-Real-Ip (solo para límites de frecuencia en memoria).
TRUST_PROXY=true

TEACHER_SESSION_HOURS=8
ROOM_TTL_MINUTES=180
MAX_ROOM_PARTICIPANTS=150
MAX_ROOMS=20
