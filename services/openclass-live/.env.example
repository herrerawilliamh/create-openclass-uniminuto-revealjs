# OpenClass Live — plantilla de configuración. Copiar a .env (NUNCA versionar .env).
# Generar los secretos con:  npm run gen-env   (o el procedimiento del README, sección «Secretos»).

APP_HOST=openclass-live.apps.willedtech.io
APP_URL=https://openclass-live.apps.willedtech.io
TZ=America/Bogota
NODE_ENV=production
PORT=3000

# Secreto de firma de tokens: 48 bytes aleatorios en base64url. Cambiarlo invalida sesiones y claves.
SESSION_SECRET=CAMBIAR_SECRET
# Acceso heredado 0.3.0 (contraseña compartida): OPCIONAL, déjelo vacío. El superusuario se crea con:
#   docker compose exec openclass-live node scripts/init-superusuario.mjs --email usted@dominio
ADMIN_PASSWORD_HASH=

# ---------- PostgreSQL (motor oficial de persistencia) ----------
# Base dedicada en este stack (servicio interact-db, red interna, sin puertos publicados). Para un PostgreSQL
# administrado: quite este perfil y apunte las cuatro URL al proveedor (con DB_SSL=verificado).
COMPOSE_PROFILES=postgres-dedicado
# Cuatro credenciales separadas (mínimo privilegio). npm run gen-env sustituye cada marcador de contraseña por un
# valor aleatorio (base64url, apto para URL) y mantiene coherentes contraseñas y URL.
POSTGRES_ADMIN_PASSWORD=CAMBIAR_PG_ADMIN
INTERACT_DB_MIGRATOR_PASSWORD=CAMBIAR_PG_MIGRADOR
INTERACT_DB_APP_PASSWORD=CAMBIAR_PG_APP
INTERACT_DB_BACKUP_PASSWORD=CAMBIAR_PG_RESPALDO
# Administración: solo la usa interact-db-preparar (crea base, esquema y roles).
DATABASE_ADMIN_URL=postgres://postgres:CAMBIAR_PG_ADMIN@interact-db:5432/postgres
# Migraciones: propietaria del esquema «interact»; solo la usa interact-migrar.
DATABASE_MIGRATION_URL=postgres://interact_migrador:CAMBIAR_PG_MIGRADOR@interact-db:5432/interact
# Aplicación: SELECT/INSERT/UPDATE/DELETE, sin DDL. La única credencial que recibe el servicio.
DATABASE_URL=postgres://interact_app:CAMBIAR_PG_APP@interact-db:5432/interact
# Respaldo: solo lectura; la usa docker-compose.respaldo.yml.
DATABASE_BACKUP_URL=postgres://interact_respaldo:CAMBIAR_PG_RESPALDO@interact-db:5432/interact
# desactivado (red interna del stack) | requerido | verificado (obligatorio con PostgreSQL administrado).
DB_SSL=desactivado
DB_POOL_MAX=10
# Carpeta del host para las copias (replicada fuera del host). Ver docs/RESPALDO-RESTAURACION.md.
BACKUP_HOST_DIR=/home/openclass-live/respaldos
BACKUP_KEEP=14

# Correo (invitaciones, verificación, recuperación). desactivado | smtp. Sin SMTP real no se envía nada.
MAIL_TRANSPORT=desactivado
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#MAIL_FROM="Interact <no-responder@su-dominio>"

# Orígenes de la presentación Reveal.js local (8613 indicado para clase; 8600 es el puerto por defecto de Vite en los cursos).
PRESENTER_ORIGINS=http://localhost:8613,http://localhost:8600
# Detrás de Traefik. Las cabeceras X-Forwarded-For/X-Real-Ip solo se aceptan si la conexión llega desde una red de
# TRUSTED_PROXY_CIDRS (recomendado: la subred exacta de la red «web», p. ej. 172.18.0.0/16). Solo afecta a límites.
TRUST_PROXY=true
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

TEACHER_SESSION_HOURS=8
ROOM_TTL_MINUTES=180
MAX_ROOM_PARTICIPANTS=150
MAX_ROOMS=20
